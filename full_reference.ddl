CREATE FOREIGN TABLE repos_update_request (
                name clob OPTIONS (ANNOTATION 'The name of the repository.'),
                description clob OPTIONS (ANNOTATION 'A short description of the repository.'),
                homepage clob OPTIONS (ANNOTATION 'A URL with more information about the repository.'),
                private boolean OPTIONS (ANNOTATION 'Either &#x60;true&#x60; to make the repository private or &#x60;false&#x60; to make it public. Default: &#x60;false&#x60;.   **Note**: You will get a &#x60;422&#x60; error if the organization restricts [changing repository visibility](https://docs.github.com/articles/repository-permission-levels-for-an-organization#changing-the-visibility-of-repositories) to organization owners and a non-owner tries to change the value of private.'),
                visibility json OPTIONS (ANNOTATION 'The visibility of the repository.'),
                security_and_analysis json OPTIONS (ANNOTATION ''),
                has_issues boolean OPTIONS (ANNOTATION 'Either &#x60;true&#x60; to enable issues for this repository or &#x60;false&#x60; to disable them.'),
                has_projects boolean OPTIONS (ANNOTATION 'Either &#x60;true&#x60; to enable projects for this repository or &#x60;false&#x60; to disable them. **Note:** If you&#39;re creating a repository in an organization that has disabled repository projects, the default is &#x60;false&#x60;, and if you pass &#x60;true&#x60;, the API returns an error.'),
                has_wiki boolean OPTIONS (ANNOTATION 'Either &#x60;true&#x60; to enable the wiki for this repository or &#x60;false&#x60; to disable it.'),
                is_template boolean OPTIONS (ANNOTATION 'Either &#x60;true&#x60; to make this repo available as a template repository or &#x60;false&#x60; to prevent it.'),
                default_branch clob OPTIONS (ANNOTATION 'Updates the default branch for this repository.'),
                allow_squash_merge boolean OPTIONS (ANNOTATION 'Either &#x60;true&#x60; to allow squash-merging pull requests, or &#x60;false&#x60; to prevent squash-merging.'),
                allow_merge_commit boolean OPTIONS (ANNOTATION 'Either &#x60;true&#x60; to allow merging pull requests with a merge commit, or &#x60;false&#x60; to prevent merging pull requests with merge commits.'),
                allow_rebase_merge boolean OPTIONS (ANNOTATION 'Either &#x60;true&#x60; to allow rebase-merging pull requests, or &#x60;false&#x60; to prevent rebase-merging.'),
                allow_auto_merge boolean OPTIONS (ANNOTATION 'Either &#x60;true&#x60; to allow auto-merge on pull requests, or &#x60;false&#x60; to disallow auto-merge.'),
                delete_branch_on_merge boolean OPTIONS (ANNOTATION 'Either &#x60;true&#x60; to allow automatically deleting head branches when pull requests are merged, or &#x60;false&#x60; to prevent automatic deletion.'),
                allow_update_branch boolean OPTIONS (ANNOTATION 'Either &#x60;true&#x60; to always allow a pull request head branch that is behind its base branch to be updated even if it is not required to be up to date before merging, or false otherwise.'),
                use_squash_pr_title_as_default boolean OPTIONS (ANNOTATION 'Either &#x60;true&#x60; to allow squash-merge commits to use pull request title, or &#x60;false&#x60; to use commit message. **This property has been deprecated. Please use &#x60;squash_merge_commit_title&#x60; instead.'),
                squash_merge_commit_title json OPTIONS (ANNOTATION 'The default value for a squash merge commit title:  - &#x60;PR_TITLE&#x60; - default to the pull request&#39;s title. - &#x60;COMMIT_OR_PR_TITLE&#x60; - default to the commit&#39;s title (if only one commit) or the pull request&#39;s title (when more than one commit).'),
                squash_merge_commit_message json OPTIONS (ANNOTATION 'The default value for a squash merge commit message:  - &#x60;PR_BODY&#x60; - default to the pull request&#39;s body. - &#x60;COMMIT_MESSAGES&#x60; - default to the branch&#39;s commit messages. - &#x60;BLANK&#x60; - default to a blank commit message.'),
                merge_commit_title json OPTIONS (ANNOTATION 'The default value for a merge commit title.  - &#x60;PR_TITLE&#x60; - default to the pull request&#39;s title. - &#x60;MERGE_MESSAGE&#x60; - default to the classic title for a merge message (e.g., Merge pull request #123 from branch-name).'),
                merge_commit_message json OPTIONS (ANNOTATION 'The default value for a merge commit message.  - &#x60;PR_TITLE&#x60; - default to the pull request&#39;s title. - &#x60;PR_BODY&#x60; - default to the pull request&#39;s body. - &#x60;BLANK&#x60; - default to a blank commit message.'),
                archived boolean OPTIONS (ANNOTATION 'Whether to archive this repository. &#x60;false&#x60; will unarchive a previously archived repository.'),
                allow_forking boolean OPTIONS (ANNOTATION 'Either &#x60;true&#x60; to allow private forks, or &#x60;false&#x60; to prevent private forks.'),
                web_commit_signoff_required boolean OPTIONS (ANNOTATION 'Either &#x60;true&#x60; to require contributors to sign off on web-based commits, or &#x60;false&#x60; to not require contributors to sign off on web-based commits.')
)
OPTIONS (ANNOTATION '');
