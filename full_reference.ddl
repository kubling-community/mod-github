                start_line decimal NOT NULL OPTIONS (ANNOTATION 'Line number at which the secret starts in the file'),
                end_line decimal NOT NULL OPTIONS (ANNOTATION 'Line number at which the secret ends in the file'),
                start_column decimal NOT NULL OPTIONS (ANNOTATION 'The column at which the secret starts within the start line when the file is interpreted as 8BIT ASCII'),
                end_column decimal NOT NULL OPTIONS (ANNOTATION 'The column at which the secret ends within the end line when the file is interpreted as 8BIT ASCII'),
                blob_sha clob NOT NULL OPTIONS (ANNOTATION 'SHA-1 hash ID of the associated blob'),
                blob_url clob NOT NULL OPTIONS (ANNOTATION 'The API URL to get the associated blob resource'),
                commit_sha clob NOT NULL OPTIONS (ANNOTATION 'SHA-1 hash ID of the associated commit'),
                commit_url clob NOT NULL OPTIONS (ANNOTATION 'The API URL to get the associated commit resource')
)
OPTIONS (ANNOTATION 'Represents a &#39;commit&#39; secret scanning location type. This location type shows that a secret was detected inside a commit to a repository.. Original model name - secret-scanning-location-commit.');
--
