                allow_auto_merge boolean OPTIONS (ANNOTATION 'Whether to allow Auto-merge to be used on pull requests.'),
                delete_branch_on_merge boolean OPTIONS (ANNOTATION 'Whether to delete head branches when pull requests are merged'),
                allow_update_branch boolean OPTIONS (ANNOTATION 'Whether or not a pull request head branch that is behind its base branch can always be updated even if it is not required to be up to date before merging.'),
                use_squash_pr_title_as_default boolean OPTIONS (ANNOTATION 'Whether a squash merge commit can use the pull request title as default. **This property has been deprecated. Please use &#x60;squash_merge_commit_title&#x60; instead.'),
                squash_merge_commit_title json OPTIONS (ANNOTATION 'The default value for a squash merge commit title:  - &#x60;PR_TITLE&#x60; - default to the pull request&#39;s title. - &#x60;COMMIT_OR_PR_TITLE&#x60; - default to the commit&#39;s title (if only one commit) or the pull request&#39;s title (when more than one commit).'),
                squash_merge_commit_message json OPTIONS (ANNOTATION 'The default value for a squash merge commit message:  - &#x60;PR_BODY&#x60; - default to the pull request&#39;s body. - &#x60;COMMIT_MESSAGES&#x60; - default to the branch&#39;s commit messages. - &#x60;BLANK&#x60; - default to a blank commit message.'),
                merge_commit_title json OPTIONS (ANNOTATION 'The default value for a merge commit title.  - &#x60;PR_TITLE&#x60; - default to the pull request&#39;s title. - &#x60;MERGE_MESSAGE&#x60; - default to the classic title for a merge message (e.g., Merge pull request #123 from branch-name).'),
                merge_commit_message json OPTIONS (ANNOTATION 'The default value for a merge commit message.  - &#x60;PR_TITLE&#x60; - default to the pull request&#39;s title. - &#x60;PR_BODY&#x60; - default to the pull request&#39;s body. - &#x60;BLANK&#x60; - default to a blank commit message.'),
                allow_merge_commit boolean OPTIONS (ANNOTATION 'Whether to allow merge commits for pull requests.'),
                allow_forking boolean OPTIONS (ANNOTATION 'Whether to allow forking this repo'),
                web_commit_signoff_required boolean OPTIONS (ANNOTATION 'Whether to require contributors to sign off on web-based commits'),
                subscribers_count integer OPTIONS (ANNOTATION ''),
                network_count integer OPTIONS (ANNOTATION ''),
                open_issues integer NOT NULL OPTIONS (ANNOTATION ''),
                watchers integer NOT NULL OPTIONS (ANNOTATION ''),
                master_branch clob OPTIONS (ANNOTATION ''),
                starred_at clob OPTIONS (ANNOTATION ''),
                anonymous_access_enabled boolean OPTIONS (ANNOTATION 'Whether anonymous git access is enabled for this repository')
)
OPTIONS (ANNOTATION 'The repository on GitHub where the event occurred. Webhook payloads contain the &#x60;repository&#x60; property when the event occurs from activity in a repository.. Original model name - nullable-repository-webhooks.');
