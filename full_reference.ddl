CREATE FOREIGN TABLE code_scanning_alert (
                number integer NOT NULL OPTIONS (ANNOTATION 'The security alert number.'),
                created_at timestamp NOT NULL OPTIONS (ANNOTATION 'The time that the alert was created in ISO 8601 format: &#x60;YYYY-MM-DDTHH:MM:SSZ&#x60;.'),
                updated_at timestamp OPTIONS (ANNOTATION 'The time that the alert was last updated in ISO 8601 format: &#x60;YYYY-MM-DDTHH:MM:SSZ&#x60;.'),
                url clob NOT NULL OPTIONS (ANNOTATION 'The REST API URL of the alert resource.'),
                html_url clob NOT NULL OPTIONS (ANNOTATION 'The GitHub URL of the alert resource.'),
                instances_url clob NOT NULL OPTIONS (ANNOTATION 'The REST API URL for fetching the list of instances for an alert.'),
                state json NOT NULL OPTIONS (ANNOTATION ''),
                fixed_at timestamp OPTIONS (ANNOTATION 'The time that the alert was no longer detected and was considered fixed in ISO 8601 format: &#x60;YYYY-MM-DDTHH:MM:SSZ&#x60;.'),
                dismissed_by json NOT NULL OPTIONS (ANNOTATION ''),
                dismissed_at timestamp NOT NULL OPTIONS (ANNOTATION 'The time that the alert was dismissed in ISO 8601 format: &#x60;YYYY-MM-DDTHH:MM:SSZ&#x60;.'),
                dismissed_reason json NOT NULL OPTIONS (ANNOTATION ''),
                dismissed_comment string OPTIONS (ANNOTATION 'The dismissal comment associated with the dismissal of the alert.'),
                rule json NOT NULL OPTIONS (ANNOTATION ''),
                tool json NOT NULL OPTIONS (ANNOTATION ''),
                most_recent_instance json NOT NULL OPTIONS (ANNOTATION '')
)
OPTIONS (ANNOTATION 'Original model name - code-scanning-alert.');
--
CREATE FOREIGN TABLE code_scanning_alert_instance (
                ref clob OPTIONS (ANNOTATION 'The Git reference, formatted as &#x60;refs/pull/&lt;number&gt;/merge&#x60;, &#x60;refs/pull/&lt;number&gt;/head&#x60;, &#x60;refs/heads/&lt;branch name&gt;&#x60; or simply &#x60;&lt;branch name&gt;&#x60;.'),
                analysis_key clob OPTIONS (ANNOTATION 'Identifies the configuration under which the analysis was executed. For example, in GitHub Actions this includes the workflow filename and job name.'),
                environment clob OPTIONS (ANNOTATION 'Identifies the variable values associated with the environment in which the analysis that generated this alert instance was performed, such as the language that was analyzed.'),
                category clob OPTIONS (ANNOTATION 'Identifies the configuration under which the analysis was executed. Used to distinguish between multiple analyses for the same tool and commit, but performed on different languages or different parts of the code.'),
                state json OPTIONS (ANNOTATION ''),
                commit_sha clob OPTIONS (ANNOTATION ''),
                message json OPTIONS (ANNOTATION ''),
                location json OPTIONS (ANNOTATION ''),
                html_url clob OPTIONS (ANNOTATION ''),
                classifications json OPTIONS (ANNOTATION 'Classifications that have been applied to the file that triggered the alert. For example identifying it as documentation, or a generated file.')
)
OPTIONS (ANNOTATION 'Original model name - code-scanning-alert-instance.');
