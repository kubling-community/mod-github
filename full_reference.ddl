CREATE FOREIGN TABLE job (
                id integer NOT NULL OPTIONS (ANNOTATION 'The id of the job.'),
                run_id integer NOT NULL OPTIONS (ANNOTATION 'The id of the associated workflow run.'),
                run_url clob NOT NULL OPTIONS (ANNOTATION ''),
                run_attempt integer OPTIONS (ANNOTATION 'Attempt number of the associated workflow run, 1 for first attempt and higher if the workflow was re-run.'),
                node_id clob NOT NULL OPTIONS (ANNOTATION ''),
                head_sha clob NOT NULL OPTIONS (ANNOTATION 'The SHA of the commit that is being run.'),
                url clob NOT NULL OPTIONS (ANNOTATION ''),
                html_url clob NOT NULL OPTIONS (ANNOTATION ''),
                status json NOT NULL OPTIONS (ANNOTATION 'The phase of the lifecycle that the job is currently in.'),
                conclusion json NOT NULL OPTIONS (ANNOTATION 'The outcome of the job.'),
                created_at timestamp NOT NULL OPTIONS (ANNOTATION 'The time that the job created, in ISO 8601 format.'),
                started_at timestamp NOT NULL OPTIONS (ANNOTATION 'The time that the job started, in ISO 8601 format.'),
                completed_at timestamp NOT NULL OPTIONS (ANNOTATION 'The time that the job finished, in ISO 8601 format.'),
                name clob NOT NULL OPTIONS (ANNOTATION 'The name of the job.'),
                steps json OPTIONS (ANNOTATION 'Steps in this job.'),
                check_run_url clob NOT NULL OPTIONS (ANNOTATION ''),
                labels json NOT NULL OPTIONS (ANNOTATION 'Labels for the workflow job. Specified by the \&quot;runs_on\&quot; attribute in the action&#39;s workflow file.'),
                runner_id integer NOT NULL OPTIONS (ANNOTATION 'The ID of the runner to which this job has been assigned. (If a runner hasn&#39;t yet been assigned, this will be null.)'),
                runner_name clob NOT NULL OPTIONS (ANNOTATION 'The name of the runner to which this job has been assigned. (If a runner hasn&#39;t yet been assigned, this will be null.)'),
                runner_group_id integer NOT NULL OPTIONS (ANNOTATION 'The ID of the runner group to which this job has been assigned. (If a runner hasn&#39;t yet been assigned, this will be null.)'),
                runner_group_name clob NOT NULL OPTIONS (ANNOTATION 'The name of the runner group to which this job has been assigned. (If a runner hasn&#39;t yet been assigned, this will be null.)'),
                workflow_name clob NOT NULL OPTIONS (ANNOTATION 'The name of the workflow.'),
                head_branch clob NOT NULL OPTIONS (ANNOTATION 'The name of the current branch.')
)
OPTIONS (ANNOTATION 'Information of a job execution in a workflow run');
--
