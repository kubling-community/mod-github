CREATE FOREIGN TABLE repos_update_webhook_config_for_repo_request (
                url clob OPTIONS (ANNOTATION 'The URL to which the payloads will be delivered.'),
                content_type clob OPTIONS (ANNOTATION 'The media type used to serialize the payloads. Supported values include &#x60;json&#x60; and &#x60;form&#x60;. The default is &#x60;form&#x60;.'),
                secret clob OPTIONS (ANNOTATION 'If provided, the &#x60;secret&#x60; will be used as the &#x60;key&#x60; to generate the HMAC hex digest value for [delivery signature headers](https://docs.github.com/webhooks/event-payloads/#delivery-headers).'),
                insecure_ssl json OPTIONS (ANNOTATION '')
)
OPTIONS (ANNOTATION '');
