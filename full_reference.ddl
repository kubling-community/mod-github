                download_location clob OPTIONS (ANNOTATION 'The location where the package can be downloaded, or NOASSERTION if this has not been determined.. Original param name - downloadLocation.'),
                files_analyzed boolean OPTIONS (ANNOTATION 'Whether the package&#39;s file content has been subjected to analysis during the creation of the SPDX document.. Original param name - filesAnalyzed.'),
                license_concluded clob OPTIONS (ANNOTATION 'The license of the package as determined while creating the SPDX document.. Original param name - licenseConcluded.'),
                license_declared clob OPTIONS (ANNOTATION 'The license of the package as declared by its author, or NOASSERTION if this information was not available when the SPDX document was created.. Original param name - licenseDeclared.'),
                supplier clob OPTIONS (ANNOTATION 'The distribution source of this package, or NOASSERTION if this was not determined.'),
                external_refs json OPTIONS (ANNOTATION 'Original param name - externalRefs.')
)
OPTIONS (ANNOTATION '');
