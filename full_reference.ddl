                wait_timer integer NOT NULL OPTIONS (ANNOTATION 'The set duration of the wait timer'),
                wait_timer_started_at timestamp NOT NULL OPTIONS (ANNOTATION 'The time that the wait timer began.'),
                current_user_can_approve boolean NOT NULL OPTIONS (ANNOTATION 'Whether the currently authenticated user can approve the deployment'),
                reviewers json NOT NULL OPTIONS (ANNOTATION 'The people or teams that may approve jobs that reference the environment. You can list up to six users or teams as reviewers. The reviewers must have at least read access to the repository. Only one of the required reviewers needs to approve the job for it to proceed.')
)
OPTIONS (ANNOTATION 'Details of a deployment that is waiting for protection rules to pass. Original model name - pending-deployment.');
