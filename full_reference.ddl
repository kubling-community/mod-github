                source_location_prefix clob OPTIONS (ANNOTATION 'The source location prefix to use. This is only available for successful analyses.'),
                artifact_url clob OPTIONS (ANNOTATION 'The URL of the artifact. This is only available for successful analyses.')
)
OPTIONS (ANNOTATION 'Original model name - code-scanning-variant-analysis-repo-task.');
