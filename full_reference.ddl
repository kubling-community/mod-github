CREATE FOREIGN TABLE personal_access_token_request (
                id integer NOT NULL OPTIONS (ANNOTATION 'Unique identifier of the request for access via fine-grained personal access token. Used as the &#x60;pat_request_id&#x60; parameter in the list and review API calls.'),
                owner json NOT NULL OPTIONS (ANNOTATION ''),
                permissions_added json NOT NULL OPTIONS (ANNOTATION ''),
                permissions_upgraded json NOT NULL OPTIONS (ANNOTATION ''),
                permissions_result json NOT NULL OPTIONS (ANNOTATION ''),
                repository_selection json NOT NULL OPTIONS (ANNOTATION 'Type of repository selection requested.'),
                repository_count integer NOT NULL OPTIONS (ANNOTATION 'The number of repositories the token is requesting access to. This field is only populated when &#x60;repository_selection&#x60; is &#x60;subset&#x60;.'),
                repositories json NOT NULL OPTIONS (ANNOTATION 'An array of repository objects the token is requesting access to. This field is only populated when &#x60;repository_selection&#x60; is &#x60;subset&#x60;.'),
                created_at clob NOT NULL OPTIONS (ANNOTATION 'Date and time when the request for access was created.'),
                token_expired boolean NOT NULL OPTIONS (ANNOTATION 'Whether the associated fine-grained personal access token has expired.'),
                token_expires_at clob NOT NULL OPTIONS (ANNOTATION 'Date and time when the associated fine-grained personal access token expires.'),
                token_last_used_at clob NOT NULL OPTIONS (ANNOTATION 'Date and time when the associated fine-grained personal access token was last used for authentication.')
)
OPTIONS (ANNOTATION 'Details of a Personal Access Token Request.. Original model name - personal-access-token-request.');
