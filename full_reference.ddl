                data_license clob NOT NULL OPTIONS (ANNOTATION 'The license under which the SPDX document is licensed.. Original param name - dataLicense.'),
                document_describes json NOT NULL OPTIONS (ANNOTATION 'The name of the repository that the SPDX document describes.. Original param name - documentDescribes.'),
