                _links json NOT NULL OPTIONS (ANNOTATION ''),
                submitted_at timestamp OPTIONS (ANNOTATION ''),
                commit_id clob NOT NULL OPTIONS (ANNOTATION 'A commit SHA for the review. If the commit object was garbage collected or forcibly deleted, then it no longer exists in Git and this value will be &#x60;null&#x60;.'),
                body_html clob OPTIONS (ANNOTATION ''),
                body_text clob OPTIONS (ANNOTATION ''),
