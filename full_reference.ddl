CREATE FOREIGN TABLE repository_advisory (
                ghsa_id clob NOT NULL OPTIONS (ANNOTATION 'The GitHub Security Advisory ID.'),
                cve_id clob NOT NULL OPTIONS (ANNOTATION 'The Common Vulnerabilities and Exposures (CVE) ID.'),
                url clob NOT NULL OPTIONS (ANNOTATION 'The API URL for the advisory.'),
                html_url clob NOT NULL OPTIONS (ANNOTATION 'The URL for the advisory.'),
                summary string NOT NULL OPTIONS (ANNOTATION 'A short summary of the advisory.'),
                description clob NOT NULL OPTIONS (ANNOTATION 'A detailed description of what the advisory entails.'),
                severity json NOT NULL OPTIONS (ANNOTATION 'The severity of the advisory.'),
                author json NOT NULL OPTIONS (ANNOTATION 'The author of the advisory.'),
                publisher json NOT NULL OPTIONS (ANNOTATION 'The publisher of the advisory.'),
                identifiers json NOT NULL OPTIONS (ANNOTATION ''),
                state json NOT NULL OPTIONS (ANNOTATION 'The state of the advisory.'),
                created_at timestamp NOT NULL OPTIONS (ANNOTATION 'The date and time of when the advisory was created, in ISO 8601 format.'),
                updated_at timestamp NOT NULL OPTIONS (ANNOTATION 'The date and time of when the advisory was last updated, in ISO 8601 format.'),
                published_at timestamp NOT NULL OPTIONS (ANNOTATION 'The date and time of when the advisory was published, in ISO 8601 format.'),
                closed_at timestamp NOT NULL OPTIONS (ANNOTATION 'The date and time of when the advisory was closed, in ISO 8601 format.'),
                withdrawn_at timestamp NOT NULL OPTIONS (ANNOTATION 'The date and time of when the advisory was withdrawn, in ISO 8601 format.'),
                submission json NOT NULL OPTIONS (ANNOTATION ''),
                vulnerabilities json NOT NULL OPTIONS (ANNOTATION ''),
                cvss json NOT NULL OPTIONS (ANNOTATION ''),
                cwes json NOT NULL OPTIONS (ANNOTATION ''),
                cwe_ids json NOT NULL OPTIONS (ANNOTATION 'A list of only the CWE IDs.'),
                credits json NOT NULL OPTIONS (ANNOTATION ''),
                credits_detailed json NOT NULL OPTIONS (ANNOTATION ''),
                collaborating_users json NOT NULL OPTIONS (ANNOTATION 'A list of users that collaborate on the advisory.'),
                collaborating_teams json NOT NULL OPTIONS (ANNOTATION 'A list of teams that collaborate on the advisory.'),
                private_fork json NOT NULL OPTIONS (ANNOTATION 'A temporary private fork of the advisory&#39;s repository for collaborating on a fix.')
)
OPTIONS (ANNOTATION 'A repository security advisory.. Original model name - repository-advisory.');
--
CREATE FOREIGN TABLE repository_advisory_create (
                summary string NOT NULL OPTIONS (ANNOTATION 'A short summary of the advisory.'),
                description clob NOT NULL OPTIONS (ANNOTATION 'A detailed description of what the advisory impacts.'),
                cve_id clob OPTIONS (ANNOTATION 'The Common Vulnerabilities and Exposures (CVE) ID.'),
                vulnerabilities json NOT NULL OPTIONS (ANNOTATION 'A product affected by the vulnerability detailed in a repository security advisory.'),
                cwe_ids json OPTIONS (ANNOTATION 'A list of Common Weakness Enumeration (CWE) IDs.'),
                credits json OPTIONS (ANNOTATION 'A list of users receiving credit for their participation in the security advisory.'),
                severity json OPTIONS (ANNOTATION 'The severity of the advisory. You must choose between setting this field or &#x60;cvss_vector_string&#x60;.'),
                cvss_vector_string clob OPTIONS (ANNOTATION 'The CVSS vector that calculates the severity of the advisory. You must choose between setting this field or &#x60;severity&#x60;.'),
                start_private_fork boolean OPTIONS (ANNOTATION 'Whether to create a temporary private fork of the repository to collaborate on a fix.')
)
OPTIONS (ANNOTATION 'Original model name - repository-advisory-create.');
