CREATE FOREIGN TABLE repos_update_branch_protection_request (
                required_status_checks json NOT NULL OPTIONS (ANNOTATION ''),
                enforce_admins boolean NOT NULL OPTIONS (ANNOTATION 'Enforce all configured restrictions for administrators. Set to &#x60;true&#x60; to enforce required status checks for repository administrators. Set to &#x60;null&#x60; to disable.'),
                required_pull_request_reviews json NOT NULL OPTIONS (ANNOTATION ''),
                restrictions json NOT NULL OPTIONS (ANNOTATION ''),
                required_linear_history boolean OPTIONS (ANNOTATION 'Enforces a linear commit Git history, which prevents anyone from pushing merge commits to a branch. Set to &#x60;true&#x60; to enforce a linear commit history. Set to &#x60;false&#x60; to disable a linear commit Git history. Your repository must allow squash merging or rebase merging before you can enable a linear commit history. Default: &#x60;false&#x60;. For more information, see \&quot;[Requiring a linear commit history](https://docs.github.com/github/administering-a-repository/requiring-a-linear-commit-history)\&quot; in the GitHub Help documentation.'),
                allow_force_pushes boolean OPTIONS (ANNOTATION 'Permits force pushes to the protected branch by anyone with write access to the repository. Set to &#x60;true&#x60; to allow force pushes. Set to &#x60;false&#x60; or &#x60;null&#x60; to block force pushes. Default: &#x60;false&#x60;. For more information, see \&quot;[Enabling force pushes to a protected branch](https://docs.github.com/github/administering-a-repository/enabling-force-pushes-to-a-protected-branch)\&quot; in the GitHub Help documentation.\&quot;'),
                allow_deletions boolean OPTIONS (ANNOTATION 'Allows deletion of the protected branch by anyone with write access to the repository. Set to &#x60;false&#x60; to prevent deletion of the protected branch. Default: &#x60;false&#x60;. For more information, see \&quot;[Enabling force pushes to a protected branch](https://docs.github.com/github/administering-a-repository/enabling-force-pushes-to-a-protected-branch)\&quot; in the GitHub Help documentation.'),
                block_creations boolean OPTIONS (ANNOTATION 'If set to &#x60;true&#x60;, the &#x60;restrictions&#x60; branch protection settings which limits who can push will also block pushes which create new branches, unless the push is initiated by a user, team, or app which has the ability to push. Set to &#x60;true&#x60; to restrict new branch creation. Default: &#x60;false&#x60;.'),
                required_conversation_resolution boolean OPTIONS (ANNOTATION 'Requires all conversations on code to be resolved before a pull request can be merged into a branch that matches this rule. Set to &#x60;false&#x60; to disable. Default: &#x60;false&#x60;.'),
                lock_branch boolean OPTIONS (ANNOTATION 'Whether to set the branch as read-only. If this is true, users will not be able to push to the branch. Default: &#x60;false&#x60;.'),
                allow_fork_syncing boolean OPTIONS (ANNOTATION 'Whether users can pull changes from upstream when the branch is locked. Set to &#x60;true&#x60; to allow fork syncing. Set to &#x60;false&#x60; to prevent fork syncing. Default: &#x60;false&#x60;.')
)
OPTIONS (ANNOTATION '');
--
CREATE FOREIGN TABLE repos_update_branch_protection_request_required_pull_request_re (
                dismissal_restrictions json OPTIONS (ANNOTATION ''),
                dismiss_stale_reviews boolean OPTIONS (ANNOTATION 'Set to &#x60;true&#x60; if you want to automatically dismiss approving reviews when someone pushes a new commit.'),
                require_code_owner_reviews boolean OPTIONS (ANNOTATION 'Blocks merging pull requests until [code owners](https://docs.github.com/articles/about-code-owners/) review them.'),
                required_approving_review_count integer OPTIONS (ANNOTATION 'Specify the number of reviewers required to approve pull requests. Use a number between 1 and 6 or 0 to not require reviewers.'),
                require_last_push_approval boolean OPTIONS (ANNOTATION 'Whether the most recent push must be approved by someone other than the person who pushed it. Default: &#x60;false&#x60;.'),
                bypass_pull_request_allowances json OPTIONS (ANNOTATION '')
)
OPTIONS (ANNOTATION 'Require at least one approving review on a pull request, before merging. Set to &#x60;null&#x60; to disable.. Original model name - repos_update_branch_protection_request_required_pull_request_reviews.');
--
CREATE FOREIGN TABLE repos_update_branch_protection_request_required_pull_request_re (
                users json OPTIONS (ANNOTATION 'The list of user &#x60;login&#x60;s allowed to bypass pull request requirements.'),
                teams json OPTIONS (ANNOTATION 'The list of team &#x60;slug&#x60;s allowed to bypass pull request requirements.'),
                apps json OPTIONS (ANNOTATION 'The list of app &#x60;slug&#x60;s allowed to bypass pull request requirements.')
)
OPTIONS (ANNOTATION 'Allow specific users, teams, or apps to bypass pull request requirements.. Original model name - repos_update_branch_protection_request_required_pull_request_reviews_bypass_pull_request_allowances.');
--
CREATE FOREIGN TABLE repos_update_branch_protection_request_required_pull_request_re (
                users json OPTIONS (ANNOTATION 'The list of user &#x60;login&#x60;s with dismissal access'),
                teams json OPTIONS (ANNOTATION 'The list of team &#x60;slug&#x60;s with dismissal access'),
                apps json OPTIONS (ANNOTATION 'The list of app &#x60;slug&#x60;s with dismissal access')
)
OPTIONS (ANNOTATION 'Specify which users, teams, and apps can dismiss pull request reviews. Pass an empty &#x60;dismissal_restrictions&#x60; object to disable. User and team &#x60;dismissal_restrictions&#x60; are only available for organization-owned repositories. Omit this parameter for personal repositories.. Original model name - repos_update_branch_protection_request_required_pull_request_reviews_dismissal_restrictions.');
--
CREATE FOREIGN TABLE repos_update_branch_protection_request_required_status_checks (
                strict boolean NOT NULL OPTIONS (ANNOTATION 'Require branches to be up to date before merging.'),
                contexts json NOT NULL OPTIONS (ANNOTATION '**Deprecated**: The list of status checks to require in order to merge into this branch. If any of these checks have recently been set by a particular GitHub App, they will be required to come from that app in future for the branch to merge. Use &#x60;checks&#x60; instead of &#x60;contexts&#x60; for more fine-grained control. '),
                checks json OPTIONS (ANNOTATION 'The list of status checks to require in order to merge into this branch.')
)
OPTIONS (ANNOTATION 'Require status checks to pass before merging. Set to &#x60;null&#x60; to disable.');
--
CREATE FOREIGN TABLE repos_update_branch_protection_request_required_status_checks_c (
                context clob NOT NULL OPTIONS (ANNOTATION 'The name of the required check'),
                app_id integer OPTIONS (ANNOTATION 'The ID of the GitHub App that must provide this check. Omit this field to automatically select the GitHub App that has recently provided this check, or any app if it was not set by a GitHub App. Pass -1 to explicitly allow any app to set the status.')
)
OPTIONS (ANNOTATION 'Original model name - repos_update_branch_protection_request_required_status_checks_checks_inner.');
--
CREATE FOREIGN TABLE repos_update_branch_protection_request_restrictions (
                users json NOT NULL OPTIONS (ANNOTATION 'The list of user &#x60;login&#x60;s with push access'),
                teams json NOT NULL OPTIONS (ANNOTATION 'The list of team &#x60;slug&#x60;s with push access'),
                apps json OPTIONS (ANNOTATION 'The list of app &#x60;slug&#x60;s with push access')
)
OPTIONS (ANNOTATION 'Restrict who can push to the protected branch. User, app, and team &#x60;restrictions&#x60; are only available for organization-owned repositories. Set to &#x60;null&#x60; to disable.');
