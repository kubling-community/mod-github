                owner json NOT NULL OPTIONS (ANNOTATION ''),
                repository_selection json NOT NULL OPTIONS (ANNOTATION 'Type of repository selection requested.'),
                repositories_url clob NOT NULL OPTIONS (ANNOTATION 'URL to the list of repositories the fine-grained personal access token can access. Only follow when &#x60;repository_selection&#x60; is &#x60;subset&#x60;.'),
                permissions json NOT NULL OPTIONS (ANNOTATION ''),
                access_granted_at clob NOT NULL OPTIONS (ANNOTATION 'Date and time when the fine-grained personal access token was approved to access the organization.'),
                token_expired boolean NOT NULL OPTIONS (ANNOTATION 'Whether the associated fine-grained personal access token has expired.'),
