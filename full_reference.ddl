)
OPTIONS (ANNOTATION '');
--
CREATE FOREIGN TABLE migrations_start_for_authenticated_user_request (
                lock_repositories boolean OPTIONS (ANNOTATION 'Lock the repositories being migrated at the start of the migration'),
                exclude_metadata boolean OPTIONS (ANNOTATION 'Indicates whether metadata should be excluded and only git source should be included for the migration.'),
                exclude_git_data boolean OPTIONS (ANNOTATION 'Indicates whether the repository git data should be excluded from the migration.'),
                exclude_attachments boolean OPTIONS (ANNOTATION 'Do not include attachments in the migration'),
                exclude_releases boolean OPTIONS (ANNOTATION 'Do not include releases in the migration'),
                exclude_owner_projects boolean OPTIONS (ANNOTATION 'Indicates whether projects owned by the organization or users should be excluded.'),
                org_metadata_only boolean OPTIONS (ANNOTATION 'Indicates whether this should only include organization metadata (repositories array should be empty and will ignore other flags).'),
                exclude json OPTIONS (ANNOTATION 'Exclude attributes from the API response to improve performance'),
                repositories json NOT NULL OPTIONS (ANNOTATION '')
)
OPTIONS (ANNOTATION '');
--
CREATE FOREIGN TABLE migrations_start_for_org_request (
                repositories json NOT NULL OPTIONS (ANNOTATION 'A list of arrays indicating which repositories should be migrated.'),
                lock_repositories boolean OPTIONS (ANNOTATION 'Indicates whether repositories should be locked (to prevent manipulation) while migrating data.'),
                exclude_metadata boolean OPTIONS (ANNOTATION 'Indicates whether metadata should be excluded and only git source should be included for the migration.'),
                exclude_git_data boolean OPTIONS (ANNOTATION 'Indicates whether the repository git data should be excluded from the migration.'),
                exclude_attachments boolean OPTIONS (ANNOTATION 'Indicates whether attachments should be excluded from the migration (to reduce migration archive file size).'),
                exclude_releases boolean OPTIONS (ANNOTATION 'Indicates whether releases should be excluded from the migration (to reduce migration archive file size).'),
                exclude_owner_projects boolean OPTIONS (ANNOTATION 'Indicates whether projects owned by the organization or users should be excluded. from the migration.'),
                org_metadata_only boolean OPTIONS (ANNOTATION 'Indicates whether this should only include organization metadata (repositories array should be empty and will ignore other flags).'),
                exclude json OPTIONS (ANNOTATION 'Exclude related items from being returned in the response in order to improve performance of the request.')
)
OPTIONS (ANNOTATION '');
