                published_at timestamp NOT NULL OPTIONS (ANNOTATION 'The time that the advisory was published in ISO 8601 format: &#x60;YYYY-MM-DDTHH:MM:SSZ&#x60;.'),
                updated_at timestamp NOT NULL OPTIONS (ANNOTATION 'The time that the advisory was last modified in ISO 8601 format: &#x60;YYYY-MM-DDTHH:MM:SSZ&#x60;.'),
                withdrawn_at timestamp NOT NULL OPTIONS (ANNOTATION 'The time that the advisory was withdrawn in ISO 8601 format: &#x60;YYYY-MM-DDTHH:MM:SSZ&#x60;.')
)
