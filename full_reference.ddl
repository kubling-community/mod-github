CREATE FOREIGN TABLE pull_request_review_comment (
                _links json NOT NULL OPTIONS (ANNOTATION ''),
                author_association json NOT NULL OPTIONS (ANNOTATION 'How the author is associated with the repository.'),
                body clob NOT NULL OPTIONS (ANNOTATION 'The text of the comment.'),
                commit_id clob NOT NULL OPTIONS (ANNOTATION 'The SHA of the commit to which the comment applies.'),
                created_at timestamp NOT NULL OPTIONS (ANNOTATION ''),
                diff_hunk clob NOT NULL OPTIONS (ANNOTATION 'The diff of the line that the comment refers to.'),
                html_url clob NOT NULL OPTIONS (ANNOTATION 'HTML URL for the pull request review comment.'),
                id integer NOT NULL OPTIONS (ANNOTATION 'The ID of the pull request review comment.'),
                in_reply_to_id integer OPTIONS (ANNOTATION 'The comment ID to reply to.'),
                line integer NOT NULL OPTIONS (ANNOTATION 'The line of the blob to which the comment applies. The last line of the range for a multi-line comment'),
                node_id clob NOT NULL OPTIONS (ANNOTATION 'The node ID of the pull request review comment.'),
                original_commit_id clob NOT NULL OPTIONS (ANNOTATION 'The SHA of the original commit to which the comment applies.'),
                original_line integer NOT NULL OPTIONS (ANNOTATION 'The line of the blob to which the comment applies. The last line of the range for a multi-line comment'),
                original_position integer NOT NULL OPTIONS (ANNOTATION 'The index of the original line in the diff to which the comment applies.'),
                original_start_line integer NOT NULL OPTIONS (ANNOTATION 'The first line of the range for a multi-line comment.'),
                path clob NOT NULL OPTIONS (ANNOTATION 'The relative path of the file to which the comment applies.'),
                position integer NOT NULL OPTIONS (ANNOTATION 'The line index in the diff to which the comment applies.'),
                pull_request_review_id integer NOT NULL OPTIONS (ANNOTATION 'The ID of the pull request review to which the comment belongs.'),
                pull_request_url clob NOT NULL OPTIONS (ANNOTATION 'URL for the pull request that the review comment belongs to.'),
                reactions json NOT NULL OPTIONS (ANNOTATION ''),
                side json NOT NULL OPTIONS (ANNOTATION 'The side of the first line of the range for a multi-line comment.'),
                start_line integer NOT NULL OPTIONS (ANNOTATION 'The first line of the range for a multi-line comment.'),
                start_side json NOT NULL OPTIONS (ANNOTATION 'The side of the first line of the range for a multi-line comment.'),
                subject_type json OPTIONS (ANNOTATION 'The level at which the comment is targeted, can be a diff line or a file.'),
                updated_at timestamp NOT NULL OPTIONS (ANNOTATION ''),
                url clob NOT NULL OPTIONS (ANNOTATION 'URL for the pull request review comment'),
                "user" json NOT NULL OPTIONS (ANNOTATION '')
)
OPTIONS (ANNOTATION 'The [comment](https://docs.github.com/rest/pulls/comments#get-a-review-comment-for-a-pull-request) itself.. Original model name - Pull_Request_Review_Comment.');
--
