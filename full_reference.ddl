CREATE FOREIGN TABLE secret_scanning_alert (
                number integer OPTIONS (ANNOTATION 'The security alert number.'),
                created_at timestamp OPTIONS (ANNOTATION 'The time that the alert was created in ISO 8601 format: &#x60;YYYY-MM-DDTHH:MM:SSZ&#x60;.'),
                updated_at timestamp OPTIONS (ANNOTATION 'The time that the alert was last updated in ISO 8601 format: &#x60;YYYY-MM-DDTHH:MM:SSZ&#x60;.'),
                url clob OPTIONS (ANNOTATION 'The REST API URL of the alert resource.'),
                html_url clob OPTIONS (ANNOTATION 'The GitHub URL of the alert resource.'),
                locations_url clob OPTIONS (ANNOTATION 'The REST API URL of the code locations for this alert.'),
                state json OPTIONS (ANNOTATION ''),
                resolution json OPTIONS (ANNOTATION ''),
                resolved_at timestamp OPTIONS (ANNOTATION 'The time that the alert was resolved in ISO 8601 format: &#x60;YYYY-MM-DDTHH:MM:SSZ&#x60;.'),
                resolved_by json OPTIONS (ANNOTATION ''),
                resolution_comment clob OPTIONS (ANNOTATION 'An optional comment to resolve an alert.'),
                secret_type clob OPTIONS (ANNOTATION 'The type of secret that secret scanning detected.'),
                secret_type_display_name clob OPTIONS (ANNOTATION 'User-friendly name for the detected secret, matching the &#x60;secret_type&#x60;. For a list of built-in patterns, see \&quot;[Secret scanning patterns](https://docs.github.com/code-security/secret-scanning/secret-scanning-patterns#supported-secrets-for-advanced-security).\&quot;'),
                secret clob OPTIONS (ANNOTATION 'The secret that was detected.'),
                push_protection_bypassed boolean OPTIONS (ANNOTATION 'Whether push protection was bypassed for the detected secret.'),
                push_protection_bypassed_by json OPTIONS (ANNOTATION ''),
                push_protection_bypassed_at timestamp OPTIONS (ANNOTATION 'The time that push protection was bypassed in ISO 8601 format: &#x60;YYYY-MM-DDTHH:MM:SSZ&#x60;.'),
                validity json OPTIONS (ANNOTATION 'The token status as of the latest validity check.')
)
OPTIONS (ANNOTATION 'Original model name - secret-scanning-alert.');
--
