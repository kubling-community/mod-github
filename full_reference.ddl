CREATE FOREIGN TABLE copilot_usage_metrics (
                "day" date NOT NULL OPTIONS (ANNOTATION 'The date for which the usage metrics are reported, in &#x60;YYYY-MM-DD&#x60; format.'),
                total_suggestions_count integer OPTIONS (ANNOTATION 'The total number of Copilot code completion suggestions shown to users.'),
                total_acceptances_count integer OPTIONS (ANNOTATION 'The total number of Copilot code completion suggestions accepted by users.'),
                total_lines_suggested integer OPTIONS (ANNOTATION 'The total number of lines of code completions suggested by Copilot.'),
                total_lines_accepted integer OPTIONS (ANNOTATION 'The total number of lines of code completions accepted by users.'),
                total_active_users integer OPTIONS (ANNOTATION 'The total number of users who were shown Copilot code completion suggestions during the day specified.'),
                total_chat_acceptances integer OPTIONS (ANNOTATION 'The total instances of users who accepted code suggested by Copilot Chat in the IDE (panel and inline).'),
                total_chat_turns integer OPTIONS (ANNOTATION 'The total number of chat turns (prompt and response pairs) sent between users and Copilot Chat in the IDE.'),
                total_active_chat_users integer OPTIONS (ANNOTATION 'The total number of users who interacted with Copilot Chat in the IDE during the day specified.'),
                breakdown json NOT NULL OPTIONS (ANNOTATION 'Breakdown of Copilot code completions usage by language and editor')
)
OPTIONS (ANNOTATION 'Summary of Copilot usage.. Original model name - copilot-usage-metrics.');
