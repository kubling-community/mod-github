                deployments_url clob NOT NULL OPTIONS (ANNOTATION ''),
                description clob NOT NULL OPTIONS (ANNOTATION ''),
                disabled boolean OPTIONS (ANNOTATION 'Returns whether or not this repository is disabled.'),
                downloads_url clob NOT NULL OPTIONS (ANNOTATION ''),
                events_url clob NOT NULL OPTIONS (ANNOTATION ''),
