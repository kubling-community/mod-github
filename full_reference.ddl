                contents_url clob NOT NULL OPTIONS (ANNOTATION ''),
                contributors_url clob NOT NULL OPTIONS (ANNOTATION ''),
                created_at json NOT NULL OPTIONS (ANNOTATION ''),
                default_branch clob NOT NULL OPTIONS (ANNOTATION 'The default branch of the repository.'),
