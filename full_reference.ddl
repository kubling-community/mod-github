                name clob NOT NULL OPTIONS (ANNOTATION 'The name of the author or committer of the commit. You&#39;ll receive a &#x60;422&#x60; status code if &#x60;name&#x60; is omitted.'),
                email clob NOT NULL OPTIONS (ANNOTATION 'The email of the author or committer of the commit. You&#39;ll receive a &#x60;422&#x60; status code if &#x60;email&#x60; is omitted.'),
                "date" clob OPTIONS (ANNOTATION '')
)
OPTIONS (ANNOTATION 'The author of the file. Default: The &#x60;committer&#x60; or the authenticated user if you omit &#x60;committer&#x60;.');
