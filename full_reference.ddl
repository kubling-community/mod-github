                scope json OPTIONS (ANNOTATION 'A notation of whether the dependency is required for the primary build artifact (runtime) or is only used for development. Future versions of this specification may allow for more granular scopes.'),
                dependencies json OPTIONS (ANNOTATION 'Array of package-url (PURLs) of direct child dependencies.')
)
