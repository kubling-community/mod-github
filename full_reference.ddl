                resolved_by json OPTIONS (ANNOTATION ''),
                secret_type clob OPTIONS (ANNOTATION 'The type of secret that secret scanning detected.'),
                secret_type_display_name clob OPTIONS (ANNOTATION 'User-friendly name for the detected secret, matching the &#x60;secret_type&#x60;. For a list of built-in patterns, see \&quot;[Secret scanning patterns](https://docs.github.com/code-security/secret-scanning/secret-scanning-patterns#supported-secrets-for-advanced-security).\&quot;'),
                secret clob OPTIONS (ANNOTATION 'The secret that was detected.'),
                repository json OPTIONS (ANNOTATION ''),
                push_protection_bypassed boolean OPTIONS (ANNOTATION 'Whether push protection was bypassed for the detected secret.'),
                push_protection_bypassed_by json OPTIONS (ANNOTATION ''),
                push_protection_bypassed_at timestamp OPTIONS (ANNOTATION 'The time that push protection was bypassed in ISO 8601 format: &#x60;YYYY-MM-DDTHH:MM:SSZ&#x60;.'),
                resolution_comment clob OPTIONS (ANNOTATION 'The comment that was optionally added when this alert was closed'),
                validity json OPTIONS (ANNOTATION 'The token status as of the latest validity check.')
)
OPTIONS (ANNOTATION 'Original model name - organization-secret-scanning-alert.');
