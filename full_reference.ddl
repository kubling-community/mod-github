                id clob OPTIONS (ANNOTATION 'A unique identifier for the rule used to detect the alert.'),
                name clob OPTIONS (ANNOTATION 'The name of the rule used to detect the alert.'),
                tags json OPTIONS (ANNOTATION 'A set of tags applicable for the rule.'),
                severity json OPTIONS (ANNOTATION 'The severity of the alert.'),
                security_severity_level json OPTIONS (ANNOTATION 'The security severity of the alert.'),
                description clob OPTIONS (ANNOTATION 'A short description of the rule used to detect the alert.')
)
OPTIONS (ANNOTATION 'Original model name - code-scanning-alert-rule-summary.');
--
CREATE FOREIGN TABLE code_scanning_analysis (
                ref clob NOT NULL OPTIONS (ANNOTATION 'The Git reference, formatted as &#x60;refs/pull/&lt;number&gt;/merge&#x60;, &#x60;refs/pull/&lt;number&gt;/head&#x60;, &#x60;refs/heads/&lt;branch name&gt;&#x60; or simply &#x60;&lt;branch name&gt;&#x60;.'),
                commit_sha string NOT NULL OPTIONS (ANNOTATION 'The SHA of the commit to which the analysis you are uploading relates.'),
                analysis_key clob NOT NULL OPTIONS (ANNOTATION 'Identifies the configuration under which the analysis was executed. For example, in GitHub Actions this includes the workflow filename and job name.'),
                environment clob NOT NULL OPTIONS (ANNOTATION 'Identifies the variable values associated with the environment in which this analysis was performed.'),
                category clob OPTIONS (ANNOTATION 'Identifies the configuration under which the analysis was executed. Used to distinguish between multiple analyses for the same tool and commit, but performed on different languages or different parts of the code.'),
                "error" clob NOT NULL OPTIONS (ANNOTATION ''),
                created_at timestamp NOT NULL OPTIONS (ANNOTATION 'The time that the analysis was created in ISO 8601 format: &#x60;YYYY-MM-DDTHH:MM:SSZ&#x60;.'),
                results_count integer NOT NULL OPTIONS (ANNOTATION 'The total number of results in the analysis.'),
                rules_count integer NOT NULL OPTIONS (ANNOTATION 'The total number of rules used in the analysis.'),
                id integer NOT NULL OPTIONS (ANNOTATION 'Unique identifier for this analysis.'),
                url clob NOT NULL OPTIONS (ANNOTATION 'The REST API URL of the analysis resource.'),
                sarif_id clob NOT NULL OPTIONS (ANNOTATION 'An identifier for the upload.'),
                tool json NOT NULL OPTIONS (ANNOTATION ''),
                deletable boolean NOT NULL OPTIONS (ANNOTATION ''),
                warning clob NOT NULL OPTIONS (ANNOTATION 'Warning generated when processing the analysis')
)
OPTIONS (ANNOTATION 'Original model name - code-scanning-analysis.');
--
