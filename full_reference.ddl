                size integer NOT NULL OPTIONS (ANNOTATION 'The size of the CodeQL database file in bytes.'),
                created_at timestamp NOT NULL OPTIONS (ANNOTATION 'The date and time at which the CodeQL database was created, in ISO 8601 format&#39;:&#39; YYYY-MM-DDTHH:MM:SSZ.'),
                updated_at timestamp NOT NULL OPTIONS (ANNOTATION 'The date and time at which the CodeQL database was last updated, in ISO 8601 format&#39;:&#39; YYYY-MM-DDTHH:MM:SSZ.'),
                url clob NOT NULL OPTIONS (ANNOTATION 'The URL at which to download the CodeQL database. The &#x60;Accept&#x60; header must be set to the value of the &#x60;content_type&#x60; property.'),
                commit_oid clob OPTIONS (ANNOTATION 'The commit SHA of the repository at the time the CodeQL database was created.')
