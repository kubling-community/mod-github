CREATE FOREIGN TABLE webhook_push (
                after clob NOT NULL OPTIONS (ANNOTATION 'The SHA of the most recent commit on &#x60;ref&#x60; after the push.'),
                base_ref clob NOT NULL OPTIONS (ANNOTATION ''),
                before clob NOT NULL OPTIONS (ANNOTATION 'The SHA of the most recent commit on &#x60;ref&#x60; before the push.'),
                commits json NOT NULL OPTIONS (ANNOTATION 'An array of commit objects describing the pushed commits. (Pushed commits are all commits that are included in the &#x60;compare&#x60; between the &#x60;before&#x60; commit and the &#x60;after&#x60; commit.) The array includes a maximum of 2048 commits. If necessary, you can use the [Commits API](https://docs.github.com/rest/commits) to fetch additional commits.'),
                compare clob NOT NULL OPTIONS (ANNOTATION 'URL that shows the changes in this &#x60;ref&#x60; update, from the &#x60;before&#x60; commit to the &#x60;after&#x60; commit. For a newly created &#x60;ref&#x60; that is directly based on the default branch, this is the comparison between the head of the default branch and the &#x60;after&#x60; commit. Otherwise, this shows all commits until the &#x60;after&#x60; commit.'),
                created boolean NOT NULL OPTIONS (ANNOTATION 'Whether this push created the &#x60;ref&#x60;.'),
                deleted boolean NOT NULL OPTIONS (ANNOTATION 'Whether this push deleted the &#x60;ref&#x60;.'),
                enterprise json OPTIONS (ANNOTATION ''),
                forced boolean NOT NULL OPTIONS (ANNOTATION 'Whether this push was a force push of the &#x60;ref&#x60;.'),
                head_commit json NOT NULL OPTIONS (ANNOTATION ''),
                installation json OPTIONS (ANNOTATION ''),
                organization json OPTIONS (ANNOTATION ''),
                pusher json NOT NULL OPTIONS (ANNOTATION ''),
                ref clob NOT NULL OPTIONS (ANNOTATION 'The full git ref that was pushed. Example: &#x60;refs/heads/main&#x60; or &#x60;refs/tags/v3.14.1&#x60;.'),
                repository json NOT NULL OPTIONS (ANNOTATION ''),
                sender json OPTIONS (ANNOTATION '')
)
OPTIONS (ANNOTATION 'Original model name - webhook-push.');
