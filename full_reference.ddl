                body clob NOT NULL OPTIONS (ANNOTATION 'The contents of the comment.'),
                path clob OPTIONS (ANNOTATION 'Relative path of the file to comment on.'),
                position integer OPTIONS (ANNOTATION 'Line index in the diff to comment on.'),
                line integer OPTIONS (ANNOTATION '**Deprecated**. Use **position** parameter instead. Line number in the file to comment on.')
)
