CREATE FOREIGN TABLE secret_scanning_location_wiki_commit (
                path clob NOT NULL OPTIONS (ANNOTATION 'The file path of the wiki page'),
                start_line decimal NOT NULL OPTIONS (ANNOTATION 'Line number at which the secret starts in the file'),
                end_line decimal NOT NULL OPTIONS (ANNOTATION 'Line number at which the secret ends in the file'),
                start_column decimal NOT NULL OPTIONS (ANNOTATION 'The column at which the secret starts within the start line when the file is interpreted as 8-bit ASCII.'),
                end_column decimal NOT NULL OPTIONS (ANNOTATION 'The column at which the secret ends within the end line when the file is interpreted as 8-bit ASCII.'),
                blob_sha clob NOT NULL OPTIONS (ANNOTATION 'SHA-1 hash ID of the associated blob'),
                page_url clob NOT NULL OPTIONS (ANNOTATION 'The GitHub URL to get the associated wiki page'),
                commit_sha clob NOT NULL OPTIONS (ANNOTATION 'SHA-1 hash ID of the associated commit'),
                commit_url clob NOT NULL OPTIONS (ANNOTATION 'The GitHub URL to get the associated wiki commit')
)
OPTIONS (ANNOTATION 'Represents a &#39;wiki_commit&#39; secret scanning location type. This location type shows that a secret was detected inside a commit to a repository wiki.. Original model name - secret-scanning-location-wiki-commit.');
