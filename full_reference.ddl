CREATE FOREIGN TABLE hook_delivery (
                id integer NOT NULL OPTIONS (ANNOTATION 'Unique identifier of the delivery.'),
                guid clob NOT NULL OPTIONS (ANNOTATION 'Unique identifier for the event (shared with all deliveries for all webhooks that subscribe to this event).'),
                delivered_at timestamp NOT NULL OPTIONS (ANNOTATION 'Time when the delivery was delivered.'),
                redelivery boolean NOT NULL OPTIONS (ANNOTATION 'Whether the delivery is a redelivery.'),
                duration decimal NOT NULL OPTIONS (ANNOTATION 'Time spent delivering.'),
                status clob NOT NULL OPTIONS (ANNOTATION 'Description of the status of the attempted delivery'),
                status_code integer NOT NULL OPTIONS (ANNOTATION 'Status code received when delivery was made.'),
                event clob NOT NULL OPTIONS (ANNOTATION 'The event that triggered the delivery.'),
                action clob NOT NULL OPTIONS (ANNOTATION 'The type of activity for the event that triggered the delivery.'),
                installation_id integer NOT NULL OPTIONS (ANNOTATION 'The id of the GitHub App installation associated with this event.'),
                repository_id integer NOT NULL OPTIONS (ANNOTATION 'The id of the repository associated with this event.'),
                throttled_at timestamp OPTIONS (ANNOTATION 'Time when the webhook delivery was throttled.'),
                url clob OPTIONS (ANNOTATION 'The URL target of the delivery.'),
                request json NOT NULL OPTIONS (ANNOTATION ''),
                response json NOT NULL OPTIONS (ANNOTATION '')
)
OPTIONS (ANNOTATION 'Delivery made by a webhook.. Original model name - hook-delivery.');
--
CREATE FOREIGN TABLE hook_delivery_item (
                id integer NOT NULL OPTIONS (ANNOTATION 'Unique identifier of the webhook delivery.'),
                guid clob NOT NULL OPTIONS (ANNOTATION 'Unique identifier for the event (shared with all deliveries for all webhooks that subscribe to this event).'),
                delivered_at timestamp NOT NULL OPTIONS (ANNOTATION 'Time when the webhook delivery occurred.'),
                redelivery boolean NOT NULL OPTIONS (ANNOTATION 'Whether the webhook delivery is a redelivery.'),
                duration decimal NOT NULL OPTIONS (ANNOTATION 'Time spent delivering.'),
                status clob NOT NULL OPTIONS (ANNOTATION 'Describes the response returned after attempting the delivery.'),
                status_code integer NOT NULL OPTIONS (ANNOTATION 'Status code received when delivery was made.'),
                event clob NOT NULL OPTIONS (ANNOTATION 'The event that triggered the delivery.'),
                action clob NOT NULL OPTIONS (ANNOTATION 'The type of activity for the event that triggered the delivery.'),
                installation_id integer NOT NULL OPTIONS (ANNOTATION 'The id of the GitHub App installation associated with this event.'),
                repository_id integer NOT NULL OPTIONS (ANNOTATION 'The id of the repository associated with this event.'),
                throttled_at timestamp OPTIONS (ANNOTATION 'Time when the webhook delivery was throttled.')
)
OPTIONS (ANNOTATION 'Delivery made by a webhook, without request and response information.. Original model name - hook-delivery-item.');
