                has_issues boolean NOT NULL OPTIONS (ANNOTATION 'Whether issues are enabled.'),
                has_pages boolean NOT NULL OPTIONS (ANNOTATION ''),
                has_projects boolean NOT NULL OPTIONS (ANNOTATION 'Whether projects are enabled.'),
                has_wiki boolean NOT NULL OPTIONS (ANNOTATION 'Whether the wiki is enabled.'),
                has_discussions boolean NOT NULL OPTIONS (ANNOTATION 'Whether discussions are enabled.'),
