                issue_events_url clob NOT NULL OPTIONS (ANNOTATION ''),
                issues_url clob NOT NULL OPTIONS (ANNOTATION ''),
                keys_url clob NOT NULL OPTIONS (ANNOTATION ''),
                labels_url clob NOT NULL OPTIONS (ANNOTATION ''),
                "language" clob NOT NULL OPTIONS (ANNOTATION ''),
                languages_url clob NOT NULL OPTIONS (ANNOTATION ''),
                license json NOT NULL OPTIONS (ANNOTATION ''),
                master_branch clob OPTIONS (ANNOTATION ''),
                merge_commit_message json OPTIONS (ANNOTATION 'The default value for a merge commit message.  - &#x60;PR_TITLE&#x60; - default to the pull request&#39;s title. - &#x60;PR_BODY&#x60; - default to the pull request&#39;s body. - &#x60;BLANK&#x60; - default to a blank commit message.'),
                merge_commit_title json OPTIONS (ANNOTATION 'The default value for a merge commit title.  - &#x60;PR_TITLE&#x60; - default to the pull request&#39;s title. - &#x60;MERGE_MESSAGE&#x60; - default to the classic title for a merge message (e.g., Merge pull request #123 from branch-name).'),
                merges_url clob NOT NULL OPTIONS (ANNOTATION ''),
                milestones_url clob NOT NULL OPTIONS (ANNOTATION ''),
                mirror_url clob NOT NULL OPTIONS (ANNOTATION ''),
                name clob NOT NULL OPTIONS (ANNOTATION 'The name of the repository.'),
                node_id clob NOT NULL OPTIONS (ANNOTATION ''),
                notifications_url clob NOT NULL OPTIONS (ANNOTATION ''),
                open_issues integer NOT NULL OPTIONS (ANNOTATION ''),
                open_issues_count integer NOT NULL OPTIONS (ANNOTATION ''),
                organization clob OPTIONS (ANNOTATION ''),
                owner json NOT NULL OPTIONS (ANNOTATION ''),
                permissions json OPTIONS (ANNOTATION ''),
                private boolean NOT NULL OPTIONS (ANNOTATION 'Whether the repository is private or public.'),
                public boolean OPTIONS (ANNOTATION ''),
                pulls_url clob NOT NULL OPTIONS (ANNOTATION ''),
                pushed_at json NOT NULL OPTIONS (ANNOTATION ''),
                releases_url clob NOT NULL OPTIONS (ANNOTATION ''),
