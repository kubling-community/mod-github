CREATE FOREIGN TABLE nullable_codespace_machine (
                name clob NOT NULL OPTIONS (ANNOTATION 'The name of the machine.'),
                display_name clob NOT NULL OPTIONS (ANNOTATION 'The display name of the machine includes cores, memory, and storage.'),
                operating_system clob NOT NULL OPTIONS (ANNOTATION 'The operating system of the machine.'),
                storage_in_bytes integer NOT NULL OPTIONS (ANNOTATION 'How much storage is available to the codespace.'),
                memory_in_bytes integer NOT NULL OPTIONS (ANNOTATION 'How much memory is available to the codespace.'),
                cpus integer NOT NULL OPTIONS (ANNOTATION 'How many cores are available to the codespace.'),
                prebuild_availability json NOT NULL OPTIONS (ANNOTATION 'Whether a prebuild is currently available when creating a codespace for this machine and repository. If a branch was not specified as a ref, the default branch will be assumed. Value will be \&quot;null\&quot; if prebuilds are not supported or prebuild availability could not be determined. Value will be \&quot;none\&quot; if no prebuild is available. Latest values \&quot;ready\&quot; and \&quot;in_progress\&quot; indicate the prebuild availability status.')
)
OPTIONS (ANNOTATION 'A description of the machine powering a codespace.. Original model name - nullable-codespace-machine.');
