                target json OPTIONS (ANNOTATION 'The target of the ruleset  **Note**: The &#x60;push&#x60; target is in beta and is subject to change.'),
                enforcement json NOT NULL OPTIONS (ANNOTATION ''),
                bypass_actors json OPTIONS (ANNOTATION 'The actors that can bypass the rules in this ruleset'),
                conditions json OPTIONS (ANNOTATION ''),
                rules json OPTIONS (ANNOTATION 'An array of rules within the ruleset.')
)
OPTIONS (ANNOTATION '');
