CREATE FOREIGN TABLE codespace (
                id integer NOT NULL OPTIONS (ANNOTATION ''),
                name clob NOT NULL OPTIONS (ANNOTATION 'Automatically generated name of this codespace.'),
                display_name clob OPTIONS (ANNOTATION 'Display name for this codespace.'),
                environment_id clob NOT NULL OPTIONS (ANNOTATION 'UUID identifying this codespace&#39;s environment.'),
                owner json NOT NULL OPTIONS (ANNOTATION ''),
                billable_owner json NOT NULL OPTIONS (ANNOTATION ''),
                repository json NOT NULL OPTIONS (ANNOTATION ''),
                machine json NOT NULL OPTIONS (ANNOTATION ''),
                devcontainer_path clob OPTIONS (ANNOTATION 'Path to devcontainer.json from repo root used to create Codespace.'),
                prebuild boolean NOT NULL OPTIONS (ANNOTATION 'Whether the codespace was created from a prebuild.'),
                created_at timestamp NOT NULL OPTIONS (ANNOTATION ''),
                updated_at timestamp NOT NULL OPTIONS (ANNOTATION ''),
                last_used_at timestamp NOT NULL OPTIONS (ANNOTATION 'Last known time this codespace was started.'),
                state json NOT NULL OPTIONS (ANNOTATION 'State of this codespace.'),
                url clob NOT NULL OPTIONS (ANNOTATION 'API URL for this codespace.'),
                git_status json NOT NULL OPTIONS (ANNOTATION ''),
                location json NOT NULL OPTIONS (ANNOTATION 'The initally assigned location of a new codespace.'),
                idle_timeout_minutes integer NOT NULL OPTIONS (ANNOTATION 'The number of minutes of inactivity after which this codespace will be automatically stopped.'),
                web_url clob NOT NULL OPTIONS (ANNOTATION 'URL to access this codespace on the web.'),
                machines_url clob NOT NULL OPTIONS (ANNOTATION 'API URL to access available alternate machine types for this codespace.'),
                start_url clob NOT NULL OPTIONS (ANNOTATION 'API URL to start this codespace.'),
                stop_url clob NOT NULL OPTIONS (ANNOTATION 'API URL to stop this codespace.'),
                publish_url clob OPTIONS (ANNOTATION 'API URL to publish this codespace to a new repository.'),
                pulls_url clob NOT NULL OPTIONS (ANNOTATION 'API URL for the Pull Request associated with this codespace, if any.'),
                recent_folders json NOT NULL OPTIONS (ANNOTATION ''),
                runtime_constraints json OPTIONS (ANNOTATION ''),
                pending_operation boolean OPTIONS (ANNOTATION 'Whether or not a codespace has a pending async operation. This would mean that the codespace is temporarily unavailable. The only thing that you can do with a codespace in this state is delete it.'),
                pending_operation_disabled_reason clob OPTIONS (ANNOTATION 'Text to show user when codespace is disabled by a pending operation'),
                idle_timeout_notice clob OPTIONS (ANNOTATION 'Text to show user when codespace idle timeout minutes has been overriden by an organization policy'),
                retention_period_minutes integer OPTIONS (ANNOTATION 'Duration in minutes after codespace has gone idle in which it will be deleted. Must be integer minutes between 0 and 43200 (30 days).'),
                retention_expires_at timestamp OPTIONS (ANNOTATION 'When a codespace will be auto-deleted based on the \&quot;retention_period_minutes\&quot; and \&quot;last_used_at\&quot;'),
                last_known_stop_notice clob OPTIONS (ANNOTATION 'The text to display to a user when a codespace has been stopped for a potentially actionable reason.')
)
OPTIONS (ANNOTATION 'A codespace.');
