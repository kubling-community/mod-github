CREATE FOREIGN TABLE rule_suite (
                id integer OPTIONS (ANNOTATION 'The unique identifier of the rule insight.'),
                actor_id integer OPTIONS (ANNOTATION 'The number that identifies the user.'),
                actor_name clob OPTIONS (ANNOTATION 'The handle for the GitHub user account.'),
                before_sha clob OPTIONS (ANNOTATION 'The first commit sha before the push evaluation.'),
                after_sha clob OPTIONS (ANNOTATION 'The last commit sha in the push evaluation.'),
                ref clob OPTIONS (ANNOTATION 'The ref name that the evaluation ran on.'),
                repository_id integer OPTIONS (ANNOTATION 'The ID of the repository associated with the rule evaluation.'),
                repository_name clob OPTIONS (ANNOTATION 'The name of the repository without the &#x60;.git&#x60; extension.'),
                pushed_at timestamp OPTIONS (ANNOTATION ''),
                result json OPTIONS (ANNOTATION 'The result of the rule evaluations for rules with the &#x60;active&#x60; enforcement status.'),
                evaluation_result json OPTIONS (ANNOTATION 'The result of the rule evaluations for rules with the &#x60;active&#x60; and &#x60;evaluate&#x60; enforcement statuses, demonstrating whether rules would pass or fail if all rules in the rule suite were &#x60;active&#x60;.'),
                rule_evaluations json OPTIONS (ANNOTATION 'Details on the evaluated rules.')
)
OPTIONS (ANNOTATION 'Response. Original model name - rule-suite.');
