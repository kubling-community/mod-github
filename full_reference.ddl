                active boolean NOT NULL OPTIONS (ANNOTATION 'Determines whether the hook is actually triggered on pushes.'),
                events json NOT NULL OPTIONS (ANNOTATION 'Determines what events the hook is triggered for. Default: [&#39;push&#39;].'),
                config json NOT NULL OPTIONS (ANNOTATION ''),
                updated_at timestamp NOT NULL OPTIONS (ANNOTATION ''),
                created_at timestamp NOT NULL OPTIONS (ANNOTATION ''),
                url clob NOT NULL OPTIONS (ANNOTATION ''),
                test_url clob NOT NULL OPTIONS (ANNOTATION ''),
