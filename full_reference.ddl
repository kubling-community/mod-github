CREATE FOREIGN TABLE nullable_issue (
                id long NOT NULL OPTIONS (ANNOTATION ''),
                node_id clob NOT NULL OPTIONS (ANNOTATION ''),
                url clob NOT NULL OPTIONS (ANNOTATION 'URL for the issue'),
                repository_url clob NOT NULL OPTIONS (ANNOTATION ''),
                labels_url clob NOT NULL OPTIONS (ANNOTATION ''),
                comments_url clob NOT NULL OPTIONS (ANNOTATION ''),
                events_url clob NOT NULL OPTIONS (ANNOTATION ''),
                html_url clob NOT NULL OPTIONS (ANNOTATION ''),
                number integer NOT NULL OPTIONS (ANNOTATION 'Number uniquely identifying the issue within its repository'),
                state clob NOT NULL OPTIONS (ANNOTATION 'State of the issue; either &#39;open&#39; or &#39;closed&#39;'),
                state_reason json OPTIONS (ANNOTATION 'The reason for the current state'),
                title clob NOT NULL OPTIONS (ANNOTATION 'Title of the issue'),
                body clob OPTIONS (ANNOTATION 'Contents of the issue'),
                "user" json NOT NULL OPTIONS (ANNOTATION ''),
                labels json NOT NULL OPTIONS (ANNOTATION 'Labels to associate with this issue; pass one or more label names to replace the set of labels on this issue; send an empty array to clear all labels from the issue; note that the labels are silently dropped for users without push access to the repository'),
                assignee json NOT NULL OPTIONS (ANNOTATION ''),
                assignees json OPTIONS (ANNOTATION ''),
                milestone json NOT NULL OPTIONS (ANNOTATION ''),
                locked boolean NOT NULL OPTIONS (ANNOTATION ''),
                active_lock_reason clob OPTIONS (ANNOTATION ''),
                comments integer NOT NULL OPTIONS (ANNOTATION ''),
                pull_request json OPTIONS (ANNOTATION ''),
                closed_at timestamp NOT NULL OPTIONS (ANNOTATION ''),
                created_at timestamp NOT NULL OPTIONS (ANNOTATION ''),
                updated_at timestamp NOT NULL OPTIONS (ANNOTATION ''),
                draft boolean OPTIONS (ANNOTATION ''),
                closed_by json OPTIONS (ANNOTATION ''),
                body_html clob OPTIONS (ANNOTATION ''),
                body_text clob OPTIONS (ANNOTATION ''),
                timeline_url clob OPTIONS (ANNOTATION ''),
                repository json OPTIONS (ANNOTATION ''),
                performed_via_github_app json OPTIONS (ANNOTATION ''),
                author_association json NOT NULL OPTIONS (ANNOTATION ''),
                reactions json OPTIONS (ANNOTATION '')
)
OPTIONS (ANNOTATION 'Issues are a great way to keep track of tasks, enhancements, and bugs for your projects.. Original model name - nullable-issue.');
