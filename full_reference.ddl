                artifact_id decimal OPTIONS (ANNOTATION 'The ID of an artifact that contains the .zip or .tar of static assets to deploy. The artifact belongs to the repository. Either &#x60;artifact_id&#x60; or &#x60;artifact_url&#x60; are required.'),
                artifact_url clob OPTIONS (ANNOTATION 'The URL of an artifact that contains the .zip or .tar of static assets to deploy. The artifact belongs to the repository. Either &#x60;artifact_id&#x60; or &#x60;artifact_url&#x60; are required.'),
                environment clob OPTIONS (ANNOTATION 'The target environment for this GitHub Pages deployment.'),
                pages_build_version clob NOT NULL OPTIONS (ANNOTATION 'A unique string that represents the version of the build for this deployment.'),
                oidc_token clob NOT NULL OPTIONS (ANNOTATION 'The OIDC token issued by GitHub Actions certifying the origin of the deployment.')
)
