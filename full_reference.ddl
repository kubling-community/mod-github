                exclude_owner_projects boolean NOT NULL OPTIONS (ANNOTATION ''),
                org_metadata_only boolean NOT NULL OPTIONS (ANNOTATION ''),
                repositories json NOT NULL OPTIONS (ANNOTATION 'The repositories included in the migration. Only returned for export migrations.'),
                url clob NOT NULL OPTIONS (ANNOTATION ''),
                created_at timestamp NOT NULL OPTIONS (ANNOTATION ''),
                updated_at timestamp NOT NULL OPTIONS (ANNOTATION ''),
                node_id clob NOT NULL OPTIONS (ANNOTATION ''),
