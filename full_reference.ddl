CREATE FOREIGN TABLE checks_update_request (
                name clob OPTIONS (ANNOTATION 'The name of the check. For example, \&quot;code-coverage\&quot;.'),
                details_url clob OPTIONS (ANNOTATION 'The URL of the integrator&#39;s site that has the full details of the check.'),
                external_id clob OPTIONS (ANNOTATION 'A reference for the run on the integrator&#39;s system.'),
                started_at timestamp OPTIONS (ANNOTATION 'This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: &#x60;YYYY-MM-DDTHH:MM:SSZ&#x60;.'),
                status json OPTIONS (ANNOTATION 'The current status of the check run. Only GitHub Actions can set a status of &#x60;waiting&#x60;, &#x60;pending&#x60;, or &#x60;requested&#x60;.'),
                conclusion json OPTIONS (ANNOTATION '**Required if you provide &#x60;completed_at&#x60; or a &#x60;status&#x60; of &#x60;completed&#x60;**. The final conclusion of the check.  **Note:** Providing &#x60;conclusion&#x60; will automatically set the &#x60;status&#x60; parameter to &#x60;completed&#x60;. You cannot change a check run conclusion to &#x60;stale&#x60;, only GitHub can set this.'),
                completed_at timestamp OPTIONS (ANNOTATION 'The time the check completed. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: &#x60;YYYY-MM-DDTHH:MM:SSZ&#x60;.'),
                "output" json OPTIONS (ANNOTATION ''),
                actions json OPTIONS (ANNOTATION 'Possible further actions the integrator can perform, which a user may trigger. Each action includes a &#x60;label&#x60;, &#x60;identifier&#x60; and &#x60;description&#x60;. A maximum of three actions are accepted. To learn more about check runs and requested actions, see \&quot;[Check runs and requested actions](https://docs.github.com/rest/guides/using-the-rest-api-to-interact-with-checks#check-runs-and-requested-actions).\&quot;')
)
OPTIONS (ANNOTATION '');
--
CREATE FOREIGN TABLE checks_update_request_any_of (
                status json OPTIONS (ANNOTATION '')
)
OPTIONS (ANNOTATION 'Original model name - checks_update_request_anyOf.');
--
CREATE FOREIGN TABLE checks_update_request_output (
                title clob OPTIONS (ANNOTATION '**Required**.'),
                summary clob NOT NULL OPTIONS (ANNOTATION 'Can contain Markdown.'),
                text clob OPTIONS (ANNOTATION 'Can contain Markdown.'),
                annotations json OPTIONS (ANNOTATION 'Adds information from your analysis to specific lines of code. Annotations are visible in GitHub&#39;s pull request UI. Annotations are visible in GitHub&#39;s pull request UI. The Checks API limits the number of annotations to a maximum of 50 per API request. To create more than 50 annotations, you have to make multiple requests to the [Update a check run](https://docs.github.com/rest/checks/runs#update-a-check-run) endpoint. Each time you update the check run, annotations are appended to the list of annotations that already exist for the check run. GitHub Actions are limited to 10 warning annotations and 10 error annotations per step. For details about annotations in the UI, see \&quot;[About status checks](https://docs.github.com/articles/about-status-checks#checks)\&quot;.'),
                images json OPTIONS (ANNOTATION 'Adds images to the output displayed in the GitHub pull request UI.')
)
OPTIONS (ANNOTATION 'Check runs can accept a variety of data in the &#x60;output&#x60; object, including a &#x60;title&#x60; and &#x60;summary&#x60; and can optionally provide descriptive details about the run.');
--
CREATE FOREIGN TABLE classroom (
                id integer NOT NULL OPTIONS (ANNOTATION 'Unique identifier of the classroom.'),
                name clob NOT NULL OPTIONS (ANNOTATION 'The name of the classroom.'),
                archived boolean NOT NULL OPTIONS (ANNOTATION 'Whether classroom is archived.'),
                organization json NOT NULL OPTIONS (ANNOTATION ''),
                url clob NOT NULL OPTIONS (ANNOTATION 'The URL of the classroom on GitHub Classroom.')
)
OPTIONS (ANNOTATION 'A GitHub Classroom classroom');
--
CREATE FOREIGN TABLE classroom_accepted_assignment (
                id integer NOT NULL OPTIONS (ANNOTATION 'Unique identifier of the repository.'),
                submitted boolean NOT NULL OPTIONS (ANNOTATION 'Whether an accepted assignment has been submitted.'),
                passing boolean NOT NULL OPTIONS (ANNOTATION 'Whether a submission passed.'),
                commit_count integer NOT NULL OPTIONS (ANNOTATION 'Count of student commits.'),
                grade clob NOT NULL OPTIONS (ANNOTATION 'Most recent grade.'),
                students json NOT NULL OPTIONS (ANNOTATION ''),
                repository json NOT NULL OPTIONS (ANNOTATION ''),
                assignment json NOT NULL OPTIONS (ANNOTATION '')
)
OPTIONS (ANNOTATION 'A GitHub Classroom accepted assignment. Original model name - classroom-accepted-assignment.');
--
CREATE FOREIGN TABLE classroom_assignment (
                id integer NOT NULL OPTIONS (ANNOTATION 'Unique identifier of the repository.'),
                public_repo boolean NOT NULL OPTIONS (ANNOTATION 'Whether an accepted assignment creates a public repository.'),
                title clob NOT NULL OPTIONS (ANNOTATION 'Assignment title.'),
                type json NOT NULL OPTIONS (ANNOTATION 'Whether it&#39;s a group assignment or individual assignment.'),
                invite_link clob NOT NULL OPTIONS (ANNOTATION 'The link that a student can use to accept the assignment.'),
                invitations_enabled boolean NOT NULL OPTIONS (ANNOTATION 'Whether the invitation link is enabled. Visiting an enabled invitation link will accept the assignment.'),
                slug clob NOT NULL OPTIONS (ANNOTATION 'Sluggified name of the assignment.'),
                students_are_repo_admins boolean NOT NULL OPTIONS (ANNOTATION 'Whether students are admins on created repository when a student accepts the assignment.'),
                feedback_pull_requests_enabled boolean NOT NULL OPTIONS (ANNOTATION 'Whether feedback pull request will be created when a student accepts the assignment.'),
                max_teams integer NOT NULL OPTIONS (ANNOTATION 'The maximum allowable teams for the assignment.'),
                max_members integer NOT NULL OPTIONS (ANNOTATION 'The maximum allowable members per team.'),
                editor clob NOT NULL OPTIONS (ANNOTATION 'The selected editor for the assignment.'),
                accepted integer NOT NULL OPTIONS (ANNOTATION 'The number of students that have accepted the assignment.'),
                submitted integer NOT NULL OPTIONS (ANNOTATION 'The number of students that have submitted the assignment.'),
                passing integer NOT NULL OPTIONS (ANNOTATION 'The number of students that have passed the assignment.'),
                "language" clob NOT NULL OPTIONS (ANNOTATION 'The programming language used in the assignment.'),
                deadline timestamp NOT NULL OPTIONS (ANNOTATION 'The time at which the assignment is due.'),
                starter_code_repository json NOT NULL OPTIONS (ANNOTATION ''),
                classroom json NOT NULL OPTIONS (ANNOTATION '')
)
OPTIONS (ANNOTATION 'A GitHub Classroom assignment. Original model name - classroom-assignment.');
--
CREATE FOREIGN TABLE classroom_assignment_grade (
                assignment_name clob NOT NULL OPTIONS (ANNOTATION 'Name of the assignment'),
                assignment_url clob NOT NULL OPTIONS (ANNOTATION 'URL of the assignment'),
                starter_code_url clob NOT NULL OPTIONS (ANNOTATION 'URL of the starter code for the assignment'),
                github_username clob NOT NULL OPTIONS (ANNOTATION 'GitHub username of the student'),
                roster_identifier clob NOT NULL OPTIONS (ANNOTATION 'Roster identifier of the student'),
                student_repository_name clob NOT NULL OPTIONS (ANNOTATION 'Name of the student&#39;s assignment repository'),
                student_repository_url clob NOT NULL OPTIONS (ANNOTATION 'URL of the student&#39;s assignment repository'),
                submission_timestamp clob NOT NULL OPTIONS (ANNOTATION 'Timestamp of the student&#39;s assignment submission'),
                points_awarded integer NOT NULL OPTIONS (ANNOTATION 'Number of points awarded to the student'),
                points_available integer NOT NULL OPTIONS (ANNOTATION 'Number of points available for the assignment'),
                group_name clob OPTIONS (ANNOTATION 'If a group assignment, name of the group the student is in')
)
OPTIONS (ANNOTATION 'Grade for a student or groups GitHub Classroom assignment. Original model name - classroom-assignment-grade.');
