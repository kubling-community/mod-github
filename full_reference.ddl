CREATE FOREIGN TABLE dependabot_alert (
                number integer NOT NULL OPTIONS (ANNOTATION 'The security alert number.'),
                state json NOT NULL OPTIONS (ANNOTATION 'The state of the Dependabot alert.'),
                dependency json NOT NULL OPTIONS (ANNOTATION ''),
                security_advisory json NOT NULL OPTIONS (ANNOTATION ''),
                security_vulnerability json NOT NULL OPTIONS (ANNOTATION ''),
                url clob NOT NULL OPTIONS (ANNOTATION 'The REST API URL of the alert resource.'),
                html_url clob NOT NULL OPTIONS (ANNOTATION 'The GitHub URL of the alert resource.'),
                created_at timestamp NOT NULL OPTIONS (ANNOTATION 'The time that the alert was created in ISO 8601 format: &#x60;YYYY-MM-DDTHH:MM:SSZ&#x60;.'),
                updated_at timestamp NOT NULL OPTIONS (ANNOTATION 'The time that the alert was last updated in ISO 8601 format: &#x60;YYYY-MM-DDTHH:MM:SSZ&#x60;.'),
                dismissed_at timestamp NOT NULL OPTIONS (ANNOTATION 'The time that the alert was dismissed in ISO 8601 format: &#x60;YYYY-MM-DDTHH:MM:SSZ&#x60;.'),
                dismissed_by json NOT NULL OPTIONS (ANNOTATION ''),
                dismissed_reason json NOT NULL OPTIONS (ANNOTATION 'The reason that the alert was dismissed.'),
                dismissed_comment string NOT NULL OPTIONS (ANNOTATION 'An optional comment associated with the alert&#39;s dismissal.'),
                fixed_at timestamp NOT NULL OPTIONS (ANNOTATION 'The time that the alert was no longer detected and was considered fixed in ISO 8601 format: &#x60;YYYY-MM-DDTHH:MM:SSZ&#x60;.'),
                auto_dismissed_at timestamp OPTIONS (ANNOTATION 'The time that the alert was auto-dismissed in ISO 8601 format: &#x60;YYYY-MM-DDTHH:MM:SSZ&#x60;.')
)
OPTIONS (ANNOTATION 'A Dependabot alert.. Original model name - dependabot-alert.');
