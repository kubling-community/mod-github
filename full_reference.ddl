CREATE FOREIGN TABLE nullable_integration (
                id integer NOT NULL OPTIONS (ANNOTATION 'Unique identifier of the GitHub app'),
                slug clob OPTIONS (ANNOTATION 'The slug name of the GitHub app'),
                node_id clob NOT NULL OPTIONS (ANNOTATION ''),
                owner json NOT NULL OPTIONS (ANNOTATION ''),
                name clob NOT NULL OPTIONS (ANNOTATION 'The name of the GitHub app'),
                description clob NOT NULL OPTIONS (ANNOTATION ''),
                external_url clob NOT NULL OPTIONS (ANNOTATION ''),
                html_url clob NOT NULL OPTIONS (ANNOTATION ''),
                created_at timestamp NOT NULL OPTIONS (ANNOTATION ''),
                updated_at timestamp NOT NULL OPTIONS (ANNOTATION ''),
                permissions json NOT NULL OPTIONS (ANNOTATION ''),
                events json NOT NULL OPTIONS (ANNOTATION 'The list of events for the GitHub app'),
                installations_count integer OPTIONS (ANNOTATION 'The number of installations associated with the GitHub app'),
                client_id clob OPTIONS (ANNOTATION ''),
                client_secret clob OPTIONS (ANNOTATION ''),
                webhook_secret clob OPTIONS (ANNOTATION ''),
                pem clob OPTIONS (ANNOTATION '')
)
OPTIONS (ANNOTATION 'GitHub apps are a new way to extend GitHub. They can be installed directly on organizations and user accounts and granted access to specific repositories. They come with granular permissions and built-in webhooks. GitHub apps are first class actors within GitHub.. Original model name - nullable-integration.');
