                ssh_url clob NOT NULL OPTIONS (ANNOTATION ''),
                clone_url clob NOT NULL OPTIONS (ANNOTATION ''),
                svn_url clob NOT NULL OPTIONS (ANNOTATION ''),
                forks integer NOT NULL OPTIONS (ANNOTATION ''),
                open_issues integer NOT NULL OPTIONS (ANNOTATION ''),
                watchers integer NOT NULL OPTIONS (ANNOTATION ''),
                topics json OPTIONS (ANNOTATION ''),
                mirror_url clob NOT NULL OPTIONS (ANNOTATION ''),
                has_issues boolean NOT NULL OPTIONS (ANNOTATION ''),
                has_projects boolean NOT NULL OPTIONS (ANNOTATION ''),
                has_pages boolean NOT NULL OPTIONS (ANNOTATION ''),
                has_wiki boolean NOT NULL OPTIONS (ANNOTATION ''),
                has_downloads boolean NOT NULL OPTIONS (ANNOTATION ''),
                has_discussions boolean OPTIONS (ANNOTATION ''),
                archived boolean NOT NULL OPTIONS (ANNOTATION ''),
                disabled boolean NOT NULL OPTIONS (ANNOTATION 'Returns whether or not this repository disabled.'),
                visibility clob OPTIONS (ANNOTATION 'The repository visibility: public, private, or internal.'),
                license json NOT NULL OPTIONS (ANNOTATION ''),
                permissions json OPTIONS (ANNOTATION ''),
                text_matches json OPTIONS (ANNOTATION ''),
                temp_clone_token clob OPTIONS (ANNOTATION ''),
                allow_merge_commit boolean OPTIONS (ANNOTATION ''),
                allow_squash_merge boolean OPTIONS (ANNOTATION ''),
                allow_rebase_merge boolean OPTIONS (ANNOTATION ''),
                allow_auto_merge boolean OPTIONS (ANNOTATION ''),
                delete_branch_on_merge boolean OPTIONS (ANNOTATION ''),
                allow_forking boolean OPTIONS (ANNOTATION ''),
                is_template boolean OPTIONS (ANNOTATION ''),
                web_commit_signoff_required boolean OPTIONS (ANNOTATION '')
)
OPTIONS (ANNOTATION 'Repo Search Result Item. Original model name - repo-search-result-item.');
