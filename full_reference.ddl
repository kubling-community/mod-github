                squash_merge_commit_title json OPTIONS (ANNOTATION 'The default value for a squash merge commit title:  - &#x60;PR_TITLE&#x60; - default to the pull request&#39;s title. - &#x60;COMMIT_OR_PR_TITLE&#x60; - default to the commit&#39;s title (if only one commit) or the pull request&#39;s title (when more than one commit).'),
                ssh_url clob NOT NULL OPTIONS (ANNOTATION ''),
                stargazers integer OPTIONS (ANNOTATION ''),
                stargazers_count integer NOT NULL OPTIONS (ANNOTATION ''),
                stargazers_url clob NOT NULL OPTIONS (ANNOTATION ''),
                statuses_url clob NOT NULL OPTIONS (ANNOTATION ''),
                subscribers_url clob NOT NULL OPTIONS (ANNOTATION ''),
                subscription_url clob NOT NULL OPTIONS (ANNOTATION ''),
                svn_url clob NOT NULL OPTIONS (ANNOTATION ''),
                tags_url clob NOT NULL OPTIONS (ANNOTATION ''),
                teams_url clob NOT NULL OPTIONS (ANNOTATION ''),
                topics json NOT NULL OPTIONS (ANNOTATION ''),
                trees_url clob NOT NULL OPTIONS (ANNOTATION ''),
                updated_at timestamp NOT NULL OPTIONS (ANNOTATION ''),
                url clob NOT NULL OPTIONS (ANNOTATION ''),
                use_squash_pr_title_as_default boolean OPTIONS (ANNOTATION 'Whether a squash merge commit can use the pull request title as default.'),
                visibility json NOT NULL OPTIONS (ANNOTATION ''),
                watchers integer NOT NULL OPTIONS (ANNOTATION ''),
                watchers_count integer NOT NULL OPTIONS (ANNOTATION ''),
                web_commit_signoff_required boolean OPTIONS (ANNOTATION 'Whether to require contributors to sign off on web-based commits')
)
OPTIONS (ANNOTATION 'A git repository. Original model name - Repository.');
