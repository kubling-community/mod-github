CREATE FOREIGN TABLE simple_repository (
                id integer NOT NULL OPTIONS (ANNOTATION 'A unique identifier of the repository.'),
                node_id clob NOT NULL OPTIONS (ANNOTATION 'The GraphQL identifier of the repository.'),
                name clob NOT NULL OPTIONS (ANNOTATION 'The name of the repository.'),
                full_name clob NOT NULL OPTIONS (ANNOTATION 'The full, globally unique, name of the repository.'),
                owner json NOT NULL OPTIONS (ANNOTATION ''),
                private boolean NOT NULL OPTIONS (ANNOTATION 'Whether the repository is private.'),
                html_url clob NOT NULL OPTIONS (ANNOTATION 'The URL to view the repository on GitHub.com.'),
                description clob NOT NULL OPTIONS (ANNOTATION 'The repository description.'),
                fork boolean NOT NULL OPTIONS (ANNOTATION 'Whether the repository is a fork.'),
                url clob NOT NULL OPTIONS (ANNOTATION 'The URL to get more information about the repository from the GitHub API.'),
                archive_url clob NOT NULL OPTIONS (ANNOTATION 'A template for the API URL to download the repository as an archive.'),
                assignees_url clob NOT NULL OPTIONS (ANNOTATION 'A template for the API URL to list the available assignees for issues in the repository.'),
                blobs_url clob NOT NULL OPTIONS (ANNOTATION 'A template for the API URL to create or retrieve a raw Git blob in the repository.'),
                branches_url clob NOT NULL OPTIONS (ANNOTATION 'A template for the API URL to get information about branches in the repository.'),
                collaborators_url clob NOT NULL OPTIONS (ANNOTATION 'A template for the API URL to get information about collaborators of the repository.'),
                comments_url clob NOT NULL OPTIONS (ANNOTATION 'A template for the API URL to get information about comments on the repository.'),
                commits_url clob NOT NULL OPTIONS (ANNOTATION 'A template for the API URL to get information about commits on the repository.'),
                compare_url clob NOT NULL OPTIONS (ANNOTATION 'A template for the API URL to compare two commits or refs.'),
                contents_url clob NOT NULL OPTIONS (ANNOTATION 'A template for the API URL to get the contents of the repository.'),
                contributors_url clob NOT NULL OPTIONS (ANNOTATION 'A template for the API URL to list the contributors to the repository.'),
                deployments_url clob NOT NULL OPTIONS (ANNOTATION 'The API URL to list the deployments of the repository.'),
                downloads_url clob NOT NULL OPTIONS (ANNOTATION 'The API URL to list the downloads on the repository.'),
                events_url clob NOT NULL OPTIONS (ANNOTATION 'The API URL to list the events of the repository.'),
                forks_url clob NOT NULL OPTIONS (ANNOTATION 'The API URL to list the forks of the repository.'),
                git_commits_url clob NOT NULL OPTIONS (ANNOTATION 'A template for the API URL to get information about Git commits of the repository.'),
                git_refs_url clob NOT NULL OPTIONS (ANNOTATION 'A template for the API URL to get information about Git refs of the repository.'),
                git_tags_url clob NOT NULL OPTIONS (ANNOTATION 'A template for the API URL to get information about Git tags of the repository.'),
                issue_comment_url clob NOT NULL OPTIONS (ANNOTATION 'A template for the API URL to get information about issue comments on the repository.'),
                issue_events_url clob NOT NULL OPTIONS (ANNOTATION 'A template for the API URL to get information about issue events on the repository.'),
                issues_url clob NOT NULL OPTIONS (ANNOTATION 'A template for the API URL to get information about issues on the repository.'),
                keys_url clob NOT NULL OPTIONS (ANNOTATION 'A template for the API URL to get information about deploy keys on the repository.'),
                labels_url clob NOT NULL OPTIONS (ANNOTATION 'A template for the API URL to get information about labels of the repository.'),
                languages_url clob NOT NULL OPTIONS (ANNOTATION 'The API URL to get information about the languages of the repository.'),
                merges_url clob NOT NULL OPTIONS (ANNOTATION 'The API URL to merge branches in the repository.'),
                milestones_url clob NOT NULL OPTIONS (ANNOTATION 'A template for the API URL to get information about milestones of the repository.'),
                notifications_url clob NOT NULL OPTIONS (ANNOTATION 'A template for the API URL to get information about notifications on the repository.'),
                pulls_url clob NOT NULL OPTIONS (ANNOTATION 'A template for the API URL to get information about pull requests on the repository.'),
                releases_url clob NOT NULL OPTIONS (ANNOTATION 'A template for the API URL to get information about releases on the repository.'),
                stargazers_url clob NOT NULL OPTIONS (ANNOTATION 'The API URL to list the stargazers on the repository.'),
                statuses_url clob NOT NULL OPTIONS (ANNOTATION 'A template for the API URL to get information about statuses of a commit.'),
                subscribers_url clob NOT NULL OPTIONS (ANNOTATION 'The API URL to list the subscribers on the repository.'),
                subscription_url clob NOT NULL OPTIONS (ANNOTATION 'The API URL to subscribe to notifications for this repository.'),
                tags_url clob NOT NULL OPTIONS (ANNOTATION 'The API URL to get information about tags on the repository.'),
                teams_url clob NOT NULL OPTIONS (ANNOTATION 'The API URL to list the teams on the repository.'),
                trees_url clob NOT NULL OPTIONS (ANNOTATION 'A template for the API URL to create or retrieve a raw Git tree of the repository.'),
                hooks_url clob NOT NULL OPTIONS (ANNOTATION 'The API URL to list the hooks on the repository.')
)
OPTIONS (ANNOTATION 'A GitHub repository.. Original model name - simple-repository.');
