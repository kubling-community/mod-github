                token_last_used_at clob NOT NULL OPTIONS (ANNOTATION 'Date and time when the associated fine-grained personal access token was last used for authentication.')
)
OPTIONS (ANNOTATION 'Minimal representation of an organization programmatic access grant for enumerations. Original model name - organization-programmatic-access-grant.');
