CREATE FOREIGN TABLE snapshot (
                version integer NOT NULL OPTIONS (ANNOTATION 'The version of the repository snapshot submission.'),
                job json NOT NULL OPTIONS (ANNOTATION ''),
                sha string NOT NULL OPTIONS (ANNOTATION 'The commit SHA associated with this dependency snapshot. Maximum length: 40 characters.'),
                ref clob NOT NULL OPTIONS (ANNOTATION 'The repository branch that triggered this snapshot.'),
                detector json NOT NULL OPTIONS (ANNOTATION ''),
                metadata json OPTIONS (ANNOTATION 'User-defined metadata to store domain-specific information limited to 8 keys with scalar values.'),
                manifests json OPTIONS (ANNOTATION 'A collection of package manifests, which are a collection of related dependencies declared in a file or representing a logical group of dependencies.'),
                scanned timestamp NOT NULL OPTIONS (ANNOTATION 'The time at which the snapshot was scanned.')
)
OPTIONS (ANNOTATION 'Create a new snapshot of a repository&#39;s dependencies.');
--
CREATE FOREIGN TABLE snapshot_detector (
                name clob NOT NULL OPTIONS (ANNOTATION 'The name of the detector used.'),
                version clob NOT NULL OPTIONS (ANNOTATION 'The version of the detector used.'),
                url clob NOT NULL OPTIONS (ANNOTATION 'The url of the detector used.')
)
OPTIONS (ANNOTATION 'A description of the detector used.');
--
CREATE FOREIGN TABLE snapshot_job (
                id clob NOT NULL OPTIONS (ANNOTATION 'The external ID of the job.'),
                correlator clob NOT NULL OPTIONS (ANNOTATION 'Correlator provides a key that is used to group snapshots submitted over time. Only the \&quot;latest\&quot; submitted snapshot for a given combination of &#x60;job.correlator&#x60; and &#x60;detector.name&#x60; will be considered when calculating a repository&#39;s current dependencies. Correlator should be as unique as it takes to distinguish all detection runs for a given \&quot;wave\&quot; of CI workflow you run. If you&#39;re using GitHub Actions, a good default value for this could be the environment variables GITHUB_WORKFLOW and GITHUB_JOB concatenated together. If you&#39;re using a build matrix, then you&#39;ll also need to add additional key(s) to distinguish between each submission inside a matrix variation.'),
                html_url clob OPTIONS (ANNOTATION 'The url for the job.')
)
OPTIONS (ANNOTATION '');
